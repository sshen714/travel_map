# Local development defaults to /. For a project Pages build use /travel_map/.
VITE_BASE_PATH=/
# Optional MapLibre style URLs. Values in VITE_* are public browser configuration.
VITE_STREET_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VITE_CUSTOM_STYLE_URL=https://tiles.openfreemap.org/styles/positron
